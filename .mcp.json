{
  "mcpServers": {
    "code-review-graph": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--quiet",
        "--from",
        "code-review-graph==2.3.9",
        "code-review-graph",
        "serve"
      ],
      "env": {
        "CRG_TOOLS": "build_or_update_graph_tool,detect_changes_tool,get_review_context_tool,get_impact_radius_tool,get_affected_flows_tool,query_graph_tool,semantic_search_nodes_tool,get_architecture_overview_tool,get_minimal_context_tool,refactor_tool,list_communities_tool"
      }
    }
  }
}
