// Page de suivi publique des projets RamiConstruct (décision utilisateur : publique).
// Déploiement : voir site/DEPLOIEMENT.md. L'identifiant de compte et le jeton
// viennent de l'environnement (CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN),
// jamais de ce fichier.
// Les « Custom Domains » créent eux-mêmes les enregistrements DNS. Le domaine
// racine laboratory.site n'est PAS utilisé : il peut déjà servir le VPS.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laboratory-projets",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "projets.laboratory.site", "custom_domain": true },
    { "pattern": "labo.laboratory.site", "custom_domain": true },
    { "pattern": "x402.laboratory.site", "custom_domain": true },
    { "pattern": "vendeur.laboratory.site", "custom_domain": true }
  ]
}
