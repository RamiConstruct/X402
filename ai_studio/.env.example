# Copier en .env (jamais commité). Valeurs par défaut = mode développement sûr.
STUDIO_DEV_MODE=true
# Obligatoire hors mode dev : python3 -c "import secrets; print(secrets.token_hex(32))"
STUDIO_SECRET_KEY=
STUDIO_DATA_DIR=./data
# STUDIO_DATABASE_URL=postgresql+psycopg://user:pass@host/db
STUDIO_PUBLIC_BASE_URL=
STUDIO_SIGNUP_CREDITS=100
STUDIO_MAX_UPLOAD_MB=200
STUDIO_MAX_DURATION_S=60
STUDIO_MAX_JOB_CREDITS=3000
STUDIO_DAILY_CREDIT_CAP=10000
STUDIO_QUOTE_TTL_S=600

# Fournisseurs payants : désactivés tant que ceci n'est pas "true" (décision humaine).
STUDIO_ALLOW_PAID_PROVIDERS=false
RUNWAYML_API_SECRET=
FAL_KEY=
